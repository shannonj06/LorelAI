# Copy to api/.env and fill in. Every setting is optional in development except a model key.
# api/.env is gitignored: never commit real keys.

# --- Model provider (see backend/llm.py) ---
# openrouter (free models, the default when OPENROUTER_API_KEY is set) or anthropic
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# Tried in order when the first model is busy (free models are often rate-limited upstream).
# Empty = no fallbacks.
# OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-super-vl:free
# Only for LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# --- Server ---
PORT=4000
# 127.0.0.1 = this machine only. Use 0.0.0.0 inside Docker or behind a reverse proxy.
HOST=127.0.0.1
# Browser origins allowed to call the API cross-origin. Not needed when the API serves the site.
CORS_ORIGINS=http://localhost:5173
# debug | info | warn | error | silent
LOG_LEVEL=info
# Behind a proxy/load balancer, so rate limits see the client IP (e.g. 1 or loopback)
# TRUST_PROXY=1
# Secure cookies need HTTPS; on by default in production
# COOKIE_SECURE=true
# The built React app, served at / (default: ../lorel-ai-frontend/dist)
# FRONTEND_DIST=

# --- Database (SQLite) ---
# Relative paths resolve from api/
DATABASE_PATH=data/lorelai.db

# --- Auth ---
# Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# scrypt cost as log2(N). 16 = 64 MB / ~150 ms per hash. Lower only for tests.
SCRYPT_COST=16

# --- Limits ---
# Requests per 15 minutes per IP to signup/signin/refresh
AUTH_RATE_LIMIT=20
# Questions per hour per signed-in user
ASK_RATE_LIMIT_PER_HOUR=60
# Landing-page demo: free questions per visitor, a per-network daily cap, and requests per IP per hour
TRIAL_QUESTION_LIMIT=3
TRIAL_IP_DAILY_LIMIT=12
TRIAL_RATE_LIMIT_PER_HOUR=20
# Saved chats per user
MAX_SAVED_CHATS=50

# --- Uploaded books (work in progress: text-based PDFs only) ---
UPLOAD_MAX_MB=25
UPLOAD_MAX_PER_USER=5
UPLOAD_RATE_LIMIT_PER_HOUR=10
# PDFs wait here until indexed, then are deleted (default: data/uploads)
# UPLOADS_DIR=

# --- Admin bootstrap ---
# On startup, if no admin exists, this account is created (or promoted) as admin.
# You can also run: npm run create-admin -- --email you@example.com
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# --- RAG pipeline (Python worker in ../backend) ---
# false = run without the pipeline (accounts work; asking returns 503)
RAG_ENABLED=true
# The Python that has backend/requirements.txt installed (python on Windows, python3 elsewhere)
# RAG_PYTHON=python
RAG_CONCURRENCY=4
RAG_TIMEOUT_MS=120000
# How long a request waits for a starting worker before returning 503
RAG_READY_WAIT_MS=30000
RAG_TOP_K=5
RAG_PER_BOOK=2
# true = don't contact the Hugging Face Hub on startup (the embedding model must already be cached)
RAG_HF_OFFLINE=false
# Where uploaded books' passages are stored (default: backend/uploads_db, gitignored)
# RAG_UPLOADS_DB=
